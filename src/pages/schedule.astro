---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/site";
import { offers } from "../data/classes";
import { classTimes, classTimesNote } from "../data/site";
---

<BaseLayout
  title="Schedule & Book"
  description="View the class schedule and book your spot at The Barn Fitness Collective in Sebastopol, CA."
>
  <section class="schedule">
    <div class="schedule-inner">
      <div class="section-eyebrow">Schedule &amp; Book</div>
      <h1 class="schedule-title">Book a <em>class.</em></h1>
      <p class="schedule-note">
        Pick a class below to reserve your spot. Having trouble?
        <a href={site.bookingUrl} target="_blank" rel="noopener">Open the booking portal in a new tab →</a>
      </p>

      <div class="schedule-frame-wrap">
        <iframe
          class="schedule-frame"
          src={site.bookingUrl}
          title="The Barn class schedule and booking"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allow="payment"></iframe>
      </div>

      <div class="schedule-list">
        <h2 class="schedule-list-title">Weekly classes <em>&amp; services.</em></h2>
        <p class="schedule-list-note">
          Here's what runs at The Barn and on which days. For exact start times and open spots,
          use the booking calendar above or the Barn Fitness Co. app.
        </p>
        <ul class="schedule-times">
          {classTimes.map((c) => (
            <li><strong>{c.label}</strong> {c.times.join(" · ")}</li>
          ))}
        </ul>
        <p class="schedule-list-note">{classTimesNote}</p>
        <ul class="schedule-list-items">
          {offers.map((o) => (
            <li>
              <span class="schedule-list-days">{o.tag}</span>
              <span class="schedule-list-name">{o.name}</span>
              <span class="schedule-list-desc">{o.description}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .schedule {
    background: var(--dark);
    padding: calc(var(--header-height) + 32px) 24px 56px;
  }
  .schedule-inner {
    max-width: 1100px;
    margin: 0 auto;
  }
  .schedule-title {
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 5vw, 3.6rem);
    font-weight: 500;
    color: var(--cream);
    letter-spacing: 0.04em;
    margin-top: 6px;
  }
  .schedule-title em {
    font-style: italic;
    color: var(--coral);
  }
  .schedule-note {
    margin-top: 12px;
    font-size: 0.92rem;
    line-height: 1.6;
    color: var(--cream);
    opacity: 0.7;
  }
  .schedule-note a {
    color: var(--coral);
    text-decoration: none;
    white-space: nowrap;
  }
  .schedule-note a:hover {
    text-decoration: underline;
  }

  /* Embed panel: a tall, fixed-height frame that scrolls INTERNALLY, so the
     booking app has room on both desktop and mobile without hijacking the page.
     Kept generous so a full day's class list fits with minimal inner scrolling.
     100dvh handles mobile browser chrome correctly. */
  .schedule-frame-wrap {
    margin-top: 24px;
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid rgba(241, 231, 212, 0.12);
    background: var(--off-white);
    height: calc(100dvh - var(--header-height) - 80px);
    min-height: 1100px;
  }
  .schedule-frame {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }
  @media (max-width: 600px) {
    .schedule {
      padding-left: 12px;
      padding-right: 12px;
    }
    .schedule-frame-wrap {
      min-height: 560px;
    }
  }
  .schedule-list {
    margin-top: 64px;
    border-top: 1px solid rgba(241, 231, 212, 0.14);
    padding-top: 40px;
  }
  .schedule-list-title {
    font-family: var(--font-display);
    font-size: clamp(1.7rem, 3.5vw, 2.4rem);
    font-weight: 500;
    color: var(--cream);
  }
  .schedule-list-title em {
    font-style: italic;
    color: var(--coral);
  }
  .schedule-list-note {
    margin-top: 12px;
    max-width: 640px;
    font-size: 0.98rem;
    line-height: 1.7;
    color: var(--cream);
    opacity: 0.7;
  }
  .schedule-times {
    list-style: none;
    margin: 20px 0 0;
    padding: 0;
    display: grid;
    gap: 8px;
    color: var(--cream);
    font-size: 1rem;
  }
  .schedule-times strong {
    display: inline-block;
    min-width: 110px;
    color: var(--coral);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: 0.82rem;
  }
  .schedule-list-items {
    list-style: none;
    margin: 28px 0 0;
    padding: 0;
  }
  .schedule-list-items li {
    display: grid;
    grid-template-columns: 150px 220px 1fr;
    gap: 8px 24px;
    padding: 16px 0;
    border-top: 1px solid rgba(241, 231, 212, 0.1);
    color: var(--cream);
    line-height: 1.6;
  }
  .schedule-list-days {
    font-size: 0.8rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--coral);
  }
  .schedule-list-name {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 700;
  }
  .schedule-list-desc {
    opacity: 0.72;
    font-size: 0.95rem;
  }
  @media (max-width: 760px) {
    .schedule-list-items li {
      grid-template-columns: 1fr;
      gap: 4px;
    }
  }
</style>
