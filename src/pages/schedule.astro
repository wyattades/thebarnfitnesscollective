---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/site";
---

<BaseLayout
  title="Schedule & Book"
  description="View the class schedule and book your spot at The Barn Fitness Collective in Sebastopol, CA."
>
  <section class="schedule">
    <div class="schedule-inner">
      <div class="section-eyebrow">Schedule &amp; Book</div>
      <h1 class="schedule-title">Book a <em>class.</em></h1>
      <p class="schedule-note">
        Pick a class below to reserve your spot. Having trouble?
        <a href={site.bookingUrl} target="_blank" rel="noopener">Open the booking portal in a new tab →</a>
      </p>

      <div class="schedule-frame-wrap">
        <iframe
          class="schedule-frame"
          src={site.bookingUrl}
          title="The Barn class schedule and booking"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allow="payment"></iframe>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .schedule {
    background: var(--dark);
    padding: calc(var(--header-height) + 32px) 24px 56px;
  }
  .schedule-inner {
    max-width: 1100px;
    margin: 0 auto;
  }
  .schedule-title {
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 5vw, 3.6rem);
    font-weight: 500;
    color: var(--cream);
    letter-spacing: 0.04em;
    margin-top: 6px;
  }
  .schedule-title em {
    font-style: italic;
    color: var(--coral);
  }
  .schedule-note {
    margin-top: 12px;
    font-size: 0.92rem;
    line-height: 1.6;
    color: var(--cream);
    opacity: 0.7;
  }
  .schedule-note a {
    color: var(--coral);
    text-decoration: none;
    white-space: nowrap;
  }
  .schedule-note a:hover {
    text-decoration: underline;
  }

  /* Embed panel: a tall, fixed-height frame that scrolls INTERNALLY, so the
     booking app has room on both desktop and mobile without hijacking the page.
     Kept generous so a full day's class list fits with minimal inner scrolling.
     100dvh handles mobile browser chrome correctly. */
  .schedule-frame-wrap {
    margin-top: 24px;
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid rgba(241, 231, 212, 0.12);
    background: var(--off-white);
    height: calc(100dvh - var(--header-height) - 80px);
    min-height: 1100px;
  }
  .schedule-frame {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }
  @media (max-width: 600px) {
    .schedule {
      padding-left: 12px;
      padding-right: 12px;
    }
    .schedule-frame-wrap {
      min-height: 560px;
    }
  }
</style>
