---
/**
 * SCHEDULE — a clean picture of the week's classes (see WeeklySchedule), with
 * the new-member sign-up front and center. The interactive booking calendar is
 * intentionally not embedded here so first-timers go to the lead-capture form
 * instead of browsing; current members get a smaller "book your class" link.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import WeeklySchedule from "../components/WeeklySchedule.astro";
import { site } from "../data/site";
import { offers } from "../data/classes";
---

<BaseLayout
  title="Class Schedule"
  description="The Barn's weekly class schedule in Sebastopol, CA: strength, conditioning, and mobility classes, all levels welcome. New here? Book your first class."
>
  <section class="schedule">
    <div class="schedule-inner">
      <div class="section-eyebrow">The Schedule</div>
      <h1 class="schedule-title">A week at <em>The Barn.</em></h1>
      <p class="schedule-note">
        Every class is one hour and every level is welcome. Here's what a typical week looks like.
      </p>
      <p class="schedule-howto">
        <strong>How to read it:</strong> find your day across the top and the time down the left
        side. The colored box where they meet is the workout.
      </p>
      <div class="schedule-cta">
        <a href="/new-here" class="btn-primary">New? Book your first class</a>
      </div>

      <div class="schedule-grid">
        <WeeklySchedule />
      </div>

      <div class="schedule-cta schedule-cta-bottom">
        <p class="schedule-cta-line">Ready to try it? Create your account and book your first class.</p>
        <a href="/new-here" class="btn-primary">New? Book your first class</a>
        <p class="schedule-member">
          Already a member?
          <a href={site.bookingUrl} target="_blank" rel="noopener">Book your class →</a>
        </p>
      </div>

      <div class="schedule-list">
        <h2 class="schedule-list-title">Weekly classes <em>&amp; services.</em></h2>
        <p class="schedule-list-note">
          What runs at The Barn and on which days. The gym is often open between classes, but
          open-gym hours aren't guaranteed.
        </p>
        <ul class="schedule-list-items">
          {offers.map((o) => (
            <li>
              <span class="schedule-list-days">{o.tag}</span>
              <span class="schedule-list-name">{o.name}</span>
              <span class="schedule-list-desc">{o.description}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .schedule {
    background: var(--dark);
    padding: calc(var(--header-height) + 40px) 24px 80px;
  }
  .schedule-inner {
    max-width: 1100px;
    margin: 0 auto;
  }
  .schedule-title {
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 5vw, 3.6rem);
    font-weight: 500;
    color: var(--cream);
    letter-spacing: 0.02em;
    margin-top: 6px;
  }
  .schedule-title em {
    font-style: italic;
    color: var(--coral);
  }
  .schedule-note {
    margin-top: 12px;
    max-width: 620px;
    font-size: 1.15rem;
    line-height: 1.7;
    color: var(--cream);
    opacity: 0.85;
  }
  .schedule-howto {
    margin-top: 14px;
    max-width: 620px;
    font-size: 1.15rem;
    line-height: 1.6;
    color: var(--cream);
  }
  .schedule-howto strong {
    color: var(--coral);
  }
  .schedule-cta {
    margin-top: 24px;
  }
  .schedule-grid {
    margin-top: 40px;
  }
  .schedule-cta-bottom {
    margin-top: 48px;
    padding: 36px 24px;
    text-align: center;
    border-radius: var(--radius);
    background: rgba(255, 111, 100, 0.08);
    border: 1px solid color-mix(in srgb, var(--coral) 35%, transparent);
  }
  .schedule-cta-line {
    font-family: var(--font-display);
    font-size: clamp(1.3rem, 3vw, 1.8rem);
    color: var(--cream);
    margin-bottom: 20px;
  }
  .schedule-member {
    margin-top: 22px;
    font-size: 0.92rem;
    color: var(--cream);
    opacity: 0.7;
  }
  .schedule-member a {
    color: var(--coral);
    text-decoration: none;
    margin-left: 4px;
  }
  .schedule-member a:hover {
    text-decoration: underline;
  }

  .schedule-list {
    margin-top: 72px;
    border-top: 1px solid rgba(241, 231, 212, 0.14);
    padding-top: 40px;
  }
  .schedule-list-title {
    font-family: var(--font-display);
    font-size: clamp(1.7rem, 3.5vw, 2.4rem);
    font-weight: 500;
    color: var(--cream);
  }
  .schedule-list-title em {
    font-style: italic;
    color: var(--coral);
  }
  .schedule-list-note {
    margin-top: 12px;
    max-width: 640px;
    font-size: 0.98rem;
    line-height: 1.7;
    color: var(--cream);
    opacity: 0.7;
  }
  .schedule-list-items {
    list-style: none;
    margin: 28px 0 0;
    padding: 0;
  }
  .schedule-list-items li {
    display: grid;
    grid-template-columns: 150px 220px 1fr;
    gap: 8px 24px;
    padding: 16px 0;
    border-top: 1px solid rgba(241, 231, 212, 0.1);
    color: var(--cream);
    line-height: 1.6;
  }
  .schedule-list-days {
    font-size: 0.8rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--coral);
  }
  .schedule-list-name {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 700;
  }
  .schedule-list-desc {
    opacity: 0.72;
    font-size: 0.95rem;
  }
  @media (max-width: 760px) {
    .schedule-list-items li {
      grid-template-columns: 1fr;
      gap: 4px;
    }
  }
</style>
