---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/site";
---

<BaseLayout title="Page Not Found" description="That page couldn't be found.">
  <section class="notfound">
    <div class="notfound-inner">
      <div class="section-eyebrow" style="justify-content:center;">404</div>
      <h1 class="notfound-title">This page took a <em>rest day.</em></h1>
      <p class="notfound-body">The page you're looking for doesn't exist or has moved.</p>
      <div class="notfound-actions">
        <a href="/" class="btn-primary">Back Home</a>
        <a href={site.bookingUrl} class="btn-ghost" target="_blank" rel="noopener">Book a Class</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .notfound {
    min-height: 70vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 160px 24px 100px;
    background: var(--dark);
  }
  .notfound-inner { text-align: center; max-width: 560px; }
  .notfound-title {
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 6vw, 4rem);
    font-weight: 900;
    color: var(--cream);
    margin: 8px 0 16px;
  }
  .notfound-title em { font-style: italic; color: var(--coral); }
  .notfound-body { color: var(--cream); opacity: 0.7; margin-bottom: 32px; }
  .notfound-actions { display: flex; gap: 14px; justify-content: center; flex-wrap: wrap; }
</style>
