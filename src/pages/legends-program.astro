---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import { site } from "../data/site";

const expect = [
  { title: "Expert Coaching", desc: "Every class is coached by a Barn team member who understands how to modify movements and work safely with your body at every stage." },
  { title: "Fully Scalable", desc: "Every movement is fully scalable. Whether it's your first time in a gym or you've been active for decades, we meet you exactly where you are." },
  { title: "Small Classes", desc: "Classes are capped so you always get personal attention. You're never just a number — we know your name, your goals, and your story." },
  { title: "Right Intensity", desc: "The intensity and rep range is deliberately lower than our regular group classes — focused on quality of movement, not max effort." },
  { title: "Real Community", desc: "Train alongside people who share your outlook. Our Legends members are some of the most supportive and inspiring people in The Barn." },
  { title: "60 Minutes", desc: "All classes are 60 minutes — enough time to get a great workout and still have the whole day ahead of you." },
];

const pricing = [
  { name: "Drop-In", price: "25", note: "Perfect for trying it out before committing.", cta: "Book a Class" },
  { name: "10-Class Pack", price: "199", note: "Great value — use anytime within 6 months of purchase.", cta: "Get the Pack" },
  { name: "2x / Week", price: "149", note: "Best for regular attendees — best value if you come twice a week.", cta: "Join Now", featured: true },
];

const questions = [
  { q: "Do I need any experience?", a: "Not at all. Legends is designed to welcome people at every experience level. Whether you've never stepped in a gym or you've been active your whole life, our coaches will meet you where you are and help you progress safely." },
  { q: "What if I have an injury or limitation?", a: "We encourage you to let our coaches know before class. Every movement can be modified to accommodate injuries, joint issues, or any physical limitation. Your safety and comfort always come first." },
  { q: "What equipment do you use?", a: "We use a variety of equipment including dumbbells, resistance bands, kettlebells, and bodyweight movements — always at appropriate loads. The focus is on functional movement patterns that translate to real life." },
  { q: "Can I try a class first?", a: "Absolutely — that's what the $25 drop-in is for. Come try a class, meet the coaches, feel the community, and see if it's a fit. No pressure, no commitment." },
  { q: "What ages is this for?", a: "Legends is designed for members 55 and over. If you're close to that age and interested, reach out to us — we're happy to chat about whether the class would be a good fit." },
];
---

<BaseLayout title="Legends Program" description="Strength training for members 55+. Age gracefully, stay strong, and keep doing the things you love.">
  <PageHero
    eyebrow="55+ Program"
    title="Age gracefully. <em>Stay strong.</em>"
    intro="Keep doing the things you love — whether that's hiking, traveling, playing with grandkids, or simply moving with more ease each day. Designed for people 55 and up who want to stay strong, balanced, and confident."
    ctaLabel="Sign Up for Legends →"
    ctaHref={site.bookingUrl}
    image="legends-duo.jpg"
    imageAlt="Two Legends members laughing together after class at The Barn"
  />

  <section class="section legends-expect">
    <div class="legends-inner">
      <div class="section-header fade-up">
        <div class="section-eyebrow">What to Expect</div>
        <h2 class="section-title">Coaching that meets <em>you where you are.</em></h2>
      </div>
      <div class="legends-grid">
        {expect.map((e) => (
          <div class="legends-card fade-up">
            <h3 class="legends-card-title">{e.title}</h3>
            <p class="legends-card-desc">{e.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section legends-pricing">
    <div class="legends-inner">
      <div class="section-header fade-up">
        <div class="section-eyebrow">Legends Pricing</div>
        <h2 class="section-title">Simple <em>options.</em></h2>
        <p class="section-body">
          Scroll to a future Monday or Wednesday to find a Legends Class. Drop in for $25, grab a 10-pack for $199, or go 2x/week for $149/month.
        </p>
      </div>
      <div class="legends-price-grid">
        {pricing.map((p) => (
          <div class:list={["legends-price", { featured: p.featured }]}>
            <div class="legends-price-name">{p.name}</div>
            <div class="legends-price-amt"><span>$</span>{p.price}</div>
            <p class="legends-price-note">{p.note}</p>
            <a class="btn-primary legends-price-cta" href={site.bookingUrl} target="_blank" rel="noopener">{p.cta}</a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section legends-q">
    <div class="legends-q-inner">
      <div class="section-header fade-up">
        <div class="section-eyebrow">Common Questions</div>
        <h2 class="section-title">Good to <em>know.</em></h2>
      </div>
      {questions.map((item) => (
        <details class="faq-item">
          <summary><span>{item.q}</span><span class="faq-icon" aria-hidden="true">+</span></summary>
          <div class="faq-answer">{item.a}</div>
        </details>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .legends-expect { background: var(--dark); }
  .legends-pricing { background: var(--dark-1); }
  .legends-q { background: var(--dark); }
  .legends-inner, .legends-q-inner { max-width: var(--content-max); margin: 0 auto; }
  .legends-q-inner { max-width: 820px; }

  .legends-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 20px;
  }
  .legends-card {
    border: 1.5px solid rgba(241, 231, 212, 0.12);
    border-radius: var(--radius);
    padding: 32px 28px;
    background: rgba(255, 255, 255, 0.02);
    transition: border-color 0.25s, transform 0.25s;
  }
  .legends-card:hover { border-color: var(--coral); transform: translateY(-4px); }
  .legends-card-title {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--cream);
    margin-bottom: 10px;
  }
  .legends-card-desc { font-size: 0.95rem; line-height: 1.7; color: var(--cream); opacity: 0.72; }

  .legends-price-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 20px;
    margin-top: 16px;
  }
  .legends-price {
    border: 1.5px solid rgba(241, 231, 212, 0.12);
    border-radius: var(--radius);
    padding: 40px 32px;
    background: rgba(255, 255, 255, 0.02);
    text-align: center;
  }
  .legends-price.featured { border-color: var(--coral); background: rgba(255, 111, 100, 0.06); }
  .legends-price-name {
    font-family: var(--font-stamp);
    font-size: 0.9rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--teal-text);
    margin-bottom: 16px;
  }
  .legends-price-amt { font-family: var(--font-stamp); font-size: 3rem; color: var(--cream); line-height: 1; }
  .legends-price-amt span { font-size: 1.2rem; vertical-align: super; }
  .legends-price-note { font-size: 0.9rem; line-height: 1.6; color: var(--cream); opacity: 0.6; margin: 16px 0 28px; }
  .legends-price-cta { width: 100%; text-align: center; display: block; }

  .faq-item { border-bottom: 1px solid rgba(241, 231, 212, 0.12); }
  .faq-item summary {
    display: flex; justify-content: space-between; align-items: center; gap: 16px;
    padding: 20px 0; cursor: pointer;
    font-family: var(--font-display); font-size: 1.15rem; font-weight: 700; color: var(--cream);
    list-style: none;
  }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-icon { color: var(--coral); font-size: 1.6rem; line-height: 1; transition: transform 0.25s; flex-shrink: 0; }
  .faq-item[open] .faq-icon { transform: rotate(45deg); }
  .faq-answer { padding: 0 0 24px; font-size: 0.98rem; line-height: 1.7; color: var(--cream); opacity: 0.72; max-width: 70ch; }
</style>
