---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import { faq } from "../data/faq";
import { renderInlineLinks } from "../lib/inline";
---

<BaseLayout title="FAQ" description="Everything you need to know before your first class at The Barn Fitness Collective.">
  <PageHero
    eyebrow="FAQ"
    title="Got <em>questions?</em>"
    intro="Everything you need to know before walking through our doors. Don't see your answer? Reach out — we'd love to hear from you."
    ctaLabel="Contact Us →"
    ctaHref="/contact"
  />

  <section class="faq section">
    <div class="faq-inner">
      {
        faq.map((cat) => (
          <div class="faq-cat">
            <h2 class="faq-cat-title">{cat.category}</h2>
            {cat.items.map((item) => (
              <details class="faq-item">
                <summary>
                  <span>{item.q}</span>
                  <span class="faq-icon" aria-hidden="true">+</span>
                </summary>
                <div class="faq-answer" set:html={renderInlineLinks(item.a)} />
              </details>
            ))}
          </div>
        ))
      }
    </div>
  </section>

  <section class="faq-cta section">
    <div class="faq-cta-inner">
      <h2 class="section-title">Still have <em>questions?</em></h2>
      <p class="section-body">We're happy to chat. Drop us a line and we'll get back to you quickly.</p>
      <a href="/contact" class="btn-primary" style="margin-top:8px;">Get in Touch →</a>
    </div>
  </section>
</BaseLayout>

<style>
  .faq {
    background: var(--dark);
    padding-top: 80px;
    padding-bottom: 80px;
  }
  .faq-inner {
    max-width: 820px;
    margin: 0 auto;
  }
  .faq-cat {
    margin-bottom: 48px;
  }
  .faq-cat-title {
    font-family: var(--font-stamp);
    font-size: 1.1rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--coral);
    margin-bottom: 16px;
  }
  .faq-item {
    border-bottom: 1px solid rgba(241, 231, 212, 0.12);
  }
  .faq-item summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding: 20px 0;
    cursor: pointer;
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--cream);
    list-style: none;
  }
  .faq-item summary::-webkit-details-marker {
    display: none;
  }
  .faq-icon {
    font-family: var(--font-body);
    font-weight: 400;
    color: var(--coral);
    font-size: 1.6rem;
    transition: transform 0.25s;
    flex-shrink: 0;
    line-height: 1;
  }
  .faq-item[open] .faq-icon {
    transform: rotate(45deg);
  }
  .faq-answer {
    padding: 0 0 24px;
    font-size: 0.98rem;
    line-height: 1.7;
    color: var(--cream);
    opacity: 0.72;
    max-width: 70ch;
  }
  .faq-answer :global(a) {
    color: var(--coral);
    text-decoration: underline;
  }
  .faq-cta {
    background: var(--dark-1);
    text-align: center;
  }
  .faq-cta-inner {
    max-width: 640px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
  }
</style>
