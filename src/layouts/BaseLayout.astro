---
/**
 * BaseLayout — the shell every page uses.
 * Provides <head> (fonts, SEO, analytics), the global Header + Footer, and the
 * scroll fade-in behavior. Every page MUST pass a `title` and a `description`
 * (that's the only SEO work a page author does — the rest is automatic via the
 * Seo component). Content goes in the default <slot />.
 */
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Analytics from "../components/Analytics.astro";
import Seo from "../components/Seo.astro";
import { site } from "../data/site";

interface Props {
  /** Page name, e.g. "Our Team". Becomes "Our Team — The Barn". */
  title?: string;
  /** REQUIRED: a unique 1–2 sentence summary (<=160 chars) for search + social. */
  description: string;
  /** Optional custom social-share image path; defaults to the site OG image. */
  image?: string;
  /** Set false on the home page so the footer's own <footer id="contact"> is used. */
  showFooter?: boolean;
}

const { title = site.name, description, image, showFooter = true } = Astro.props;

const fullTitle =
  title === site.name || title === site.shortName
    ? site.name
    : `${title} — ${site.shortName}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <Seo title={fullTitle} description={description} image={image} />

    <!-- Fonts: Playfair Display (display), DM Sans (body), Bebas Neue (stamp) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;0,900;1,700;1,900&family=DM+Sans:wght@300;400;500;600;700&family=Bebas+Neue&display=swap"
      rel="stylesheet"
    />

    <Analytics />

    <!-- Per-page extras (e.g. page-specific structured data) go here. -->
    <slot name="head" />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    {showFooter && <Footer />}

    <script>
      // Reveal .fade-up elements as they scroll into view.
      const els = document.querySelectorAll<HTMLElement>(".fade-up");
      if ("IntersectionObserver" in window && els.length) {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("visible");
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.1 },
        );
        els.forEach((el) => observer.observe(el));
      } else {
        els.forEach((el) => el.classList.add("visible"));
      }
    </script>
  </body>
</html>
