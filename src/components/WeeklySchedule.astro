---
/**
 * WeeklySchedule — the week's classes as a simple, high-contrast grid:
 *   DAY across the top → the WORKOUT in a bold colored band → the TIMES listed
 *   underneath. Rows line up across all days like a spreadsheet.
 *
 * Built to be easy to read at a glance: large dark text on a light background,
 * heavy grid lines, no tiny tags, nothing clickable. Data: src/data/schedule.ts
 *
 * Layout notes: each day is a column that spans 3 rows (day name, first
 * workout, second workout) and uses CSS subgrid so the rows line up across
 * days. Desktop = 6 columns, tablet = 3, phone = 1.
 */
import { weeklySchedule } from "../data/schedule";

const SLOTS = 2; // at most two kinds of workout per day
---

<div class="ws" role="group" aria-label="Weekly class schedule">
  {
    weeklySchedule.map((d) => (
      <section class="ws-day">
        <h3 class="ws-dayname">{d.day}</h3>
        {Array.from({ length: SLOTS }).map((_, i) => {
          const c = d.classes[i];
          return c ? (
            <div class={`ws-slot ws-${c.color}`}>
              <div class="ws-name">{c.name}</div>
              <ul class="ws-times">
                {c.times.map((t) => (
                  <li>{t}</li>
                ))}
              </ul>
            </div>
          ) : (
            <div class="ws-slot ws-empty" aria-hidden="true"></div>
          );
        })}
      </section>
    ))
  }
</div>

<style>
  .ws {
    --line: 3px solid #211a1b;
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    grid-auto-rows: auto;
    background: #fbf7ef;
    color: #211a1b;
    border: var(--line);
    border-radius: var(--radius-sm);
    overflow: hidden;
    user-select: none;
  }
  .ws-day {
    grid-row: span 3;
    display: grid;
    grid-template-rows: subgrid;
    border-left: var(--line);
  }
  .ws-day:first-child {
    border-left: none;
  }

  /* DAY header */
  .ws-dayname {
    margin: 0;
    padding: 18px 8px;
    text-align: center;
    background: #211a1b;
    color: #fbf7ef;
    font-family: var(--font-body);
    font-size: 1.3rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  /* WORKOUT band + TIMES */
  .ws-slot {
    --tint: #ffd9d5;
    border-top: var(--line);
    display: flex;
    flex-direction: column;
  }
  .ws-name {
    min-height: 4.4em;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 10px 8px;
    text-align: center;
    background: var(--tint);
    border-bottom: 2px solid #211a1b;
    font-family: var(--font-body);
    font-size: 1.2rem;
    font-weight: 800;
    line-height: 1.2;
  }
  .ws-times {
    list-style: none;
    margin: 0;
    padding: 12px 8px 16px;
    text-align: center;
  }
  .ws-times li {
    padding: 6px 0;
    font-size: 1.2rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    line-height: 1.3;
  }
  .ws-times li + li {
    border-top: 1px solid rgba(33, 26, 27, 0.22);
  }
  .ws-empty {
    background: repeating-linear-gradient(
      135deg,
      transparent 0 10px,
      rgba(33, 26, 27, 0.05) 10px 11px
    );
  }

  /* Each kind of workout keeps its own light tint everywhere it appears. */
  .ws-coral { --tint: #ffd0cb; }
  .ws-sky { --tint: #cfe6ff; }
  .ws-teal { --tint: #c9ebf3; }
  .ws-acid { --tint: #e6f5a8; }
  .ws-peach { --tint: #ffdcb0; }
  .ws-lavender { --tint: #e3d6ff; }
  .ws-cream { --tint: #e8dfcb; }

  /* Tablet: 3 days across, 2 rows of days. */
  @media (max-width: 1000px) {
    .ws {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .ws-day:nth-child(3n + 1) {
      border-left: none;
    }
    .ws-day:nth-child(n + 4) {
      border-top: var(--line);
    }
  }

  /* Phone: one day at a time, stacked. */
  @media (max-width: 600px) {
    .ws {
      grid-template-columns: minmax(0, 1fr);
    }
    .ws-day {
      border-left: none;
    }
    .ws-day:nth-child(n + 2) {
      border-top: var(--line);
    }
    .ws-empty {
      display: none;
    }
    .ws-dayname {
      font-size: 1.5rem;
      text-align: left;
      padding: 16px 18px;
    }
    .ws-name {
      min-height: 0;
      justify-content: flex-start;
      padding: 14px 18px;
      font-size: 1.35rem;
    }
    .ws-times {
      text-align: left;
      padding: 8px 18px 14px;
    }
    .ws-times li {
      font-size: 1.35rem;
      padding: 8px 0;
    }
  }
</style>
