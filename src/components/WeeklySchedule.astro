---
/**
 * WeeklySchedule — the week's classes as a true spreadsheet grid:
 *   DAYS across the top, START TIMES down the left, and each box says which
 *   workout is happening then. A time that appears on several days sits on the
 *   same row, so it lines up straight across.
 *
 * Built to be easy to read at a glance: large dark text, heavy grid lines,
 * brand colors, nothing clickable. Data: src/data/schedule.ts
 *
 * Phones can't fit 7 columns, so below 760px the same data is shown as one
 * card per day (time on the left, workout beside it, still in time order).
 */
import { weeklySchedule } from "../data/schedule";

const toMinutes = (t: string) => {
  const [, h, m, ap] = t.match(/(\d+):(\d+)\s*(AM|PM)/i)!;
  return ((Number(h) % 12) + (ap.toUpperCase() === "PM" ? 12 : 0)) * 60 + Number(m);
};

// Every distinct start time in the week, earliest first (one grid row each).
const times = [
  ...new Set(weeklySchedule.flatMap((d) => d.classes.flatMap((c) => c.times))),
].sort((a, b) => toMinutes(a) - toMinutes(b));

const classAt = (dayIndex: number, time: string) =>
  weeklySchedule[dayIndex].classes.find((c) => c.times.includes(time));

// For the phone cards: a day's classes in time order.
const dayRows = weeklySchedule.map((d) =>
  d.classes
    .flatMap((c) => c.times.map((t) => ({ time: t, name: c.name, color: c.color })))
    .sort((a, b) => toMinutes(a.time) - toMinutes(b.time)),
);
---

<div class="ws-wrap">
  <table class="ws-table">
    <caption class="ws-sr">Weekly class schedule: days across the top, start times down the side.</caption>
    <thead>
      <tr>
        <th class="ws-corner" scope="col">Time</th>
        {weeklySchedule.map((d) => <th scope="col" class="ws-dayname">{d.day}</th>)}
      </tr>
    </thead>
    <tbody>
      {
        times.map((t) => (
          <tr>
            <th scope="row" class="ws-time">{t}</th>
            {weeklySchedule.map((_, i) => {
              const c = classAt(i, t);
              return c ? (
                <td class={`ws-cell ws-${c.color}`}>{c.name}</td>
              ) : (
                <td class="ws-cell ws-empty" aria-label="No class" />
              );
            })}
          </tr>
        ))
      }
    </tbody>
  </table>

  <div class="ws-days" aria-label="Weekly class schedule by day">
    {
      weeklySchedule.map((d, i) => (
        <section class="ws-day">
          <h3 class="ws-dayname-card">{d.day}</h3>
          <ul>
            {dayRows[i].map((r) => (
              <li>
                <span class="ws-card-time">{r.time}</span>
                <span class={`ws-card-name ws-${r.color}`}>{r.name}</span>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</div>

<style>
  .ws-wrap {
    --line: 3px solid #211a1b;
    --thin: 1px solid rgba(33, 26, 27, 0.35);
    background: #faf6ef;
    color: #211a1b;
    border: var(--line);
    border-radius: var(--radius-sm);
    overflow: hidden;
    user-select: none;
  }
  .ws-sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }

  /* ---------- Big grid (computers + tablets) ---------- */
  .ws-table {
    width: 100%;
    border-collapse: collapse;
    table-layout: fixed;
    font-family: var(--font-body);
  }
  .ws-table th,
  .ws-table td {
    border: var(--thin);
    text-align: center;
    vertical-align: middle;
  }
  .ws-corner,
  .ws-dayname {
    background: #211a1b;
    color: #faf6ef;
    padding: 16px 4px;
    font-size: 1.05rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    border: var(--line) !important;
  }
  .ws-corner {
    width: 112px;
    color: var(--coral);
  }
  .ws-time {
    background: #f1e7d4;
    padding: 0 8px;
    font-size: 1.1rem;
    font-weight: 800;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
    border-right: var(--line) !important;
  }
  .ws-cell {
    height: 62px;
    padding: 6px 8px;
    font-size: 1.05rem;
    font-weight: 700;
    line-height: 1.2;
  }
  .ws-empty {
    background: repeating-linear-gradient(
      135deg,
      transparent 0 10px,
      rgba(33, 26, 27, 0.05) 10px 11px
    );
  }

  /* On-brand class colors (all pass contrast with their text color). */
  .ws-coral { background: var(--coral); color: #211a1b; }
  .ws-sky { background: var(--sky); color: #211a1b; }
  .ws-teal { background: var(--teal); color: #fff; }
  .ws-acid { background: var(--acid); color: #211a1b; }
  .ws-rust { background: var(--rust); color: #faf6ef; }
  .ws-dark { background: #211a1b; color: #faf6ef; }
  .ws-cream { background: #f1e7d4; color: #211a1b; box-shadow: inset 0 0 0 2px #211a1b; }

  /* ---------- Phone cards ---------- */
  .ws-days {
    display: none;
  }
  @media (max-width: 760px) {
    .ws-table {
      display: none;
    }
    .ws-days {
      display: block;
    }
    .ws-day + .ws-day {
      border-top: var(--line);
    }
    .ws-dayname-card {
      margin: 0;
      padding: 14px 18px;
      background: #211a1b;
      color: #faf6ef;
      font-family: var(--font-body);
      font-size: 1.5rem;
      font-weight: 800;
      letter-spacing: 0.05em;
      text-transform: uppercase;
    }
    .ws-day ul {
      list-style: none;
      margin: 0;
      padding: 0;
    }
    .ws-day li {
      display: grid;
      grid-template-columns: 7.2rem 1fr;
      align-items: stretch;
      border-top: var(--thin);
    }
    .ws-day li:first-child {
      border-top: none;
    }
    .ws-card-time {
      display: flex;
      align-items: center;
      padding: 12px 14px;
      background: #f1e7d4;
      border-right: var(--line);
      font-size: 1.25rem;
      font-weight: 800;
      font-variant-numeric: tabular-nums;
      white-space: nowrap;
    }
    .ws-card-name {
      display: flex;
      align-items: center;
      padding: 12px 14px;
      font-size: 1.25rem;
      font-weight: 700;
      line-height: 1.2;
    }
  }
</style>
