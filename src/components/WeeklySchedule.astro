---
/**
 * WeeklySchedule — a clean, look-don't-touch picture of the week's classes
 * (class name + start times). Nothing here is clickable on purpose: the goal
 * is to show what a week at The Barn looks like and nudge new people toward
 * the sign-up form instead of browsing a booking calendar.
 * Data: src/data/schedule.ts
 */
import { weeklySchedule } from "../data/schedule";
---

<div class="ws" role="group" aria-label="Weekly class schedule">
  {
    weeklySchedule.map((d) => (
      <section class="ws-day">
        <h3 class="ws-day-name">{d.day}</h3>
        {d.classes.map((c) => (
          <div class={`ws-class ws-${c.color}`}>
            <div class="ws-class-name">{c.name}</div>
            <ul class="ws-times">
              {c.times.map((t) => (
                <li>{t}</li>
              ))}
            </ul>
          </div>
        ))}
      </section>
    ))
  }
</div>

<style>
  .ws {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    user-select: none;
  }
  .ws-day {
    background: rgba(255, 255, 255, 0.035);
    border: 1px solid rgba(241, 231, 212, 0.12);
    border-radius: var(--radius);
    padding: 22px 20px 12px;
  }
  .ws-day-name {
    font-family: var(--font-stamp);
    font-size: 1.15rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    font-weight: 400;
    color: var(--cream);
    margin-bottom: 14px;
  }
  .ws-class {
    --accent: var(--coral);
    padding: 4px 0 14px 14px;
    margin-bottom: 8px;
    border-left: 3px solid var(--accent);
  }
  .ws-class-name {
    font-family: var(--font-display);
    font-size: 1.08rem;
    font-weight: 700;
    color: var(--cream);
    margin-bottom: 8px;
  }
  .ws-times {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .ws-times li {
    font-size: 0.74rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    color: var(--accent);
    border: 1px solid color-mix(in srgb, var(--accent) 45%, transparent);
    background: color-mix(in srgb, var(--accent) 10%, transparent);
    border-radius: var(--radius-pill);
    padding: 4px 11px;
    white-space: nowrap;
  }

  .ws-coral { --accent: var(--coral); }
  .ws-sky { --accent: var(--sky); }
  .ws-teal { --accent: var(--teal-text); }
  .ws-acid { --accent: var(--acid); }
  .ws-peach { --accent: #ffb86b; }
  .ws-lavender { --accent: #c7a6ff; }
  .ws-cream { --accent: var(--cream); }

  @media (max-width: 900px) {
    .ws {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 560px) {
    .ws {
      grid-template-columns: 1fr;
    }
  }
</style>
