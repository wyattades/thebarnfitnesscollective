---
/**
 * TeamMember — one coach card. Photo is optimized via <Img>.
 */
import Img from "./Img.astro";
import type { Coach } from "../data/team";
const { name, role, photo, initial, creds } = Astro.props as Coach;
---

<div class="team-card fade-up">
  <div class="team-photo">
    <div class="team-initial">{initial}</div>
    <Img name={photo} alt={name} class="team-photo-img" width={500} />
    <div class="team-creds">
      {creds.map((c) => <span class="cred-tag">{c}</span>)}
    </div>
  </div>
  <div class="team-info">
    <div class="team-name">{name}</div>
    <div class="team-role">{role}</div>
  </div>
</div>

<style>
  .team-card {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius);
  }
  .team-photo {
    aspect-ratio: 3 / 4;
    position: relative;
    overflow: hidden;
    background: linear-gradient(160deg, #3d2215 0%, #6b3a25 100%);
  }
  .team-initial {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display);
    font-size: 5rem;
    font-weight: 900;
    font-style: italic;
    color: rgba(241, 231, 212, 0.15);
    z-index: 0;
  }
  .team-photo :global(.team-photo-img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    z-index: 1;
    transition: transform 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }
  .team-card:hover :global(.team-photo-img) {
    transform: scale(1.05);
  }
  .team-creds {
    position: absolute;
    bottom: 12px;
    left: 12px;
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    z-index: 2;
  }
  .cred-tag {
    background: rgba(38, 38, 38, 0.75);
    backdrop-filter: blur(6px);
    color: var(--sky);
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 3px 8px;
    border-radius: var(--radius-sm);
    font-weight: 600;
  }
  .team-info {
    background: var(--dark);
    padding: 20px;
  }
  .team-name {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--cream);
    margin-bottom: 4px;
  }
  .team-role {
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--coral);
    font-weight: 500;
  }
</style>
