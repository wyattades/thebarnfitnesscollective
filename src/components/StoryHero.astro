---
/**
 * StoryHero — the "Where strength comes to life" headline hero that follows the
 * video banner. Dark background with a faint decorative grid.
 */
import { site } from "../data/site";
import Img from "./Img.astro";
---

<section class="hero" id="story">
  <div class="hero-bg"></div>
  <div class="hero-grid"></div>
  <div class="hero-content">
    <div class="hero-copy">
      <div class="hero-eyebrow">Sebastopol, CA · Est. 2023</div>
      <h1 class="hero-headline">
        Where <em>strength</em><br />
        <span class="alt-line">comes to life.</span>
      </h1>
      <p class="hero-sub">
        <span>Functional Fitness</span><span class="dot" aria-hidden="true">·</span><span>Community</span><span class="dot" aria-hidden="true">·</span><span>Sebastopol</span>
      </p>
      <div class="hero-actions">
        <a href={site.bookingUrl} class="btn-primary" target="_blank" rel="noopener">Book Your First Class</a>
        <a href="#about" class="btn-ghost">Our Story</a>
      </div>
    </div>
    <div class="hero-photo">
      <Img
        name="home-strength.png"
        alt="Members training with dumbbells during a class at The Barn"
        class="hero-photo-img"
        width={900}
        widths={[900, 1400]}
        sizes="(max-width: 900px) 100vw, 46vw"
        quality={65}
      />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding: 120px 0 60px;
    overflow: hidden;
    background: var(--dark);
  }
  .hero-bg {
    position: absolute;
    inset: 0;
    background: var(--dark);
  }
  .hero-grid {
    position: absolute;
    inset: 0;
    background-image:
      radial-gradient(
        65% 85% at 12% 115%,
        color-mix(in srgb, var(--coral) 24%, transparent),
        transparent 60%
      ),
      radial-gradient(
        50% 70% at 100% 0%,
        color-mix(in srgb, var(--teal) 14%, transparent),
        transparent 55%
      ),
      linear-gradient(rgba(241, 231, 212, 0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(241, 231, 212, 0.03) 1px, transparent 1px);
    background-size: 100% 100%, 100% 100%, 64px 64px, 64px 64px;
  }
  .hero-content {
    z-index: 2;
    padding: 0 48px;
    max-width: var(--content-max);
    margin: 0 auto;
    width: 100%;
    display: grid;
    grid-template-columns: 1fr;
    align-items: center;
  }
  .hero-copy {
    min-width: 0;
    max-width: 50%;
  }
  /* Full-bleed photo: runs off the right, top, and bottom edges of the hero. */
  .hero-photo {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: 46%;
    overflow: hidden;
  }
  .hero-photo :global(.hero-photo-img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }
  .hero-eyebrow {
    font-family: var(--font-stamp);
    font-size: 0.9rem;
    letter-spacing: 0.28em;
    color: var(--coral);
    text-transform: uppercase;
    margin-bottom: 26px;
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 7px 16px 5px;
    border: 1px solid color-mix(in srgb, var(--coral) 45%, transparent);
    border-radius: var(--radius-pill);
  }
  .hero-eyebrow::before {
    content: "";
    display: inline-block;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--coral);
  }
  .hero-headline {
    font-family: var(--font-display);
    font-size: clamp(3rem, 5.5vw, 5.75rem);
    letter-spacing: -0.02em;
    line-height: 0.98;
    font-weight: 500;
    color: var(--cream);
    margin-bottom: 16px;
  }
  .hero-headline em {
    font-style: italic;
    color: var(--coral);
  }
  .hero-headline .alt-line {
    color: var(--sky);
    font-style: italic;
  }
  .hero-sub {
    font-size: 1.05rem;
    font-weight: 300;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--cream);
    opacity: 0.7;
    margin-bottom: 48px;
  }
  .hero-sub span {
    white-space: nowrap;
  }
  .hero-sub .dot {
    margin: 0 0.5em;
  }
  .hero-actions {
    display: flex;
    gap: 16px;
    align-items: center;
    flex-wrap: wrap;
  }
  @media (max-width: 900px) {
    /* Don't force a full-screen section on mobile; it left a big gap under
       the video. */
    .hero {
      min-height: 0;
      padding: 36px 0 0;
    }
    .hero-content {
      display: flex;
      flex-direction: column;
      gap: 40px;
      padding-left: 24px;
      padding-right: 24px;
    }
    /* Center the whole headline block when the layout stacks. */
    .hero-copy {
      max-width: none;
      text-align: center;
    }
    .hero-actions {
      justify-content: center;
    }
    /* The photo drops below the text and bleeds edge to edge. */
    .hero-photo {
      position: relative;
      width: calc(100% + 48px);
      margin: 0 -24px;
      aspect-ratio: 4 / 5;
    }
  }
  @media (max-width: 600px) {
    .hero-sub {
      font-size: 0.72rem;
      letter-spacing: 0.05em;
      margin-bottom: 36px;
    }
    .hero-actions {
      flex-direction: column;
      align-items: center;
      gap: 12px;
    }
  }
</style>
