---
/**
 * StoryHero — the "Where strength comes to life" headline hero that follows the
 * video banner. Dark background with a faint decorative grid.
 */
import { site } from "../data/site";
import Img from "./Img.astro";
---

<section class="hero" id="story">
  <div class="hero-bg"></div>
  <div class="hero-grid"></div>
  <div class="hero-content">
    <div class="hero-copy">
      <div class="hero-eyebrow">Sebastopol, CA · Est. 2023</div>
      <h1 class="hero-headline">
        Where <em>strength</em><br />
        <span class="alt-line">comes to life.</span>
      </h1>
      <p class="hero-sub">Functional Fitness · Community · Sebastopol</p>
      <div class="hero-actions">
        <a href={site.bookingUrl} class="btn-primary" target="_blank" rel="noopener">Book Your First Class</a>
        <a href="#about" class="btn-ghost">Our Story</a>
      </div>
    </div>
    <div class="hero-photo">
      <Img
        name="home-strength.png"
        alt="Members training with dumbbells during a class at The Barn"
        class="hero-photo-img"
        width={1000}
      />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding: 120px 0 60px;
    overflow: hidden;
    background: var(--dark);
  }
  .hero-bg {
    position: absolute;
    inset: 0;
    background: var(--dark);
  }
  .hero-grid {
    position: absolute;
    inset: 0;
    background-image:
      radial-gradient(
        65% 85% at 12% 115%,
        color-mix(in srgb, var(--coral) 24%, transparent),
        transparent 60%
      ),
      radial-gradient(
        50% 70% at 100% 0%,
        color-mix(in srgb, var(--teal) 14%, transparent),
        transparent 55%
      ),
      linear-gradient(rgba(241, 231, 212, 0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(241, 231, 212, 0.03) 1px, transparent 1px);
    background-size: 100% 100%, 100% 100%, 64px 64px, 64px 64px;
  }
  .hero-content {
    position: relative;
    z-index: 2;
    padding: 0 48px;
    max-width: var(--content-max);
    margin: 0 auto;
    width: 100%;
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 64px;
    align-items: center;
  }
  .hero-copy {
    min-width: 0;
  }
  .hero-photo {
    position: relative;
    aspect-ratio: 4 / 5;
    border-radius: var(--radius);
    overflow: hidden;
  }
  .hero-photo :global(.hero-photo-img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }
  /* Thin coral frame accent to tie into the brand. */
  .hero-photo::after {
    content: "";
    position: absolute;
    inset: 0;
    border: 1px solid rgba(241, 231, 212, 0.15);
    border-radius: var(--radius);
    pointer-events: none;
  }
  .hero-eyebrow {
    font-family: var(--font-stamp);
    font-size: 0.9rem;
    letter-spacing: 0.28em;
    color: var(--coral);
    text-transform: uppercase;
    margin-bottom: 26px;
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 7px 16px 5px;
    border: 1px solid color-mix(in srgb, var(--coral) 45%, transparent);
    border-radius: var(--radius-pill);
  }
  .hero-eyebrow::before {
    content: "";
    display: inline-block;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--coral);
  }
  .hero-headline {
    font-family: var(--font-display);
    font-size: clamp(3rem, 5.5vw, 5.75rem);
    letter-spacing: -0.02em;
    line-height: 0.98;
    font-weight: 500;
    color: var(--cream);
    margin-bottom: 16px;
  }
  .hero-headline em {
    font-style: italic;
    color: var(--coral);
  }
  .hero-headline .alt-line {
    color: var(--sky);
    font-style: italic;
  }
  .hero-sub {
    font-size: 1.05rem;
    font-weight: 300;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--cream);
    opacity: 0.7;
    margin-bottom: 48px;
  }
  .hero-actions {
    display: flex;
    gap: 16px;
    align-items: center;
    flex-wrap: wrap;
  }
  @media (max-width: 900px) {
    .hero-content {
      grid-template-columns: 1fr;
      gap: 40px;
      padding-left: 24px;
      padding-right: 24px;
    }
    /* On mobile, photo drops below the headline block. */
    .hero-photo {
      aspect-ratio: 16 / 11;
      max-height: 60vh;
    }
  }
  @media (max-width: 600px) {
    .hero-actions {
      flex-direction: column;
      align-items: flex-start;
      gap: 12px;
    }
  }
</style>
