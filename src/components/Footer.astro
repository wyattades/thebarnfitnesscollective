---
/**
 * Global site footer. Links come from src/data/site.ts (footerNav).
 */
import { site, footerNav } from "../data/site";
const year = new Date().getFullYear();
const isExternal = (href: string) => /^https?:\/\//.test(href) || href.startsWith("mailto:");
---

<footer id="contact">
  <div class="footer-top">
    <div class="footer-brand">
      <div class="brand-name">{site.name}</div>
      <p class="brand-tagline">{site.tagline}</p>
      <address class="footer-address">
        {site.address.line1}<br />
        {site.address.line2}<br /><br />
        <a href={`mailto:${site.email}`} class="footer-email">{site.email}</a>
      </address>
    </div>

    <div>
      <div class="footer-col-title">Explore</div>
      <ul class="footer-links">
        {footerNav.explore.map((l) => (
          <li>
            <a href={l.href} {...(isExternal(l.href) ? { target: "_blank", rel: "noopener" } : {})}>{l.label}</a>
          </li>
        ))}
      </ul>
    </div>

    <div>
      <div class="footer-col-title">Contact</div>
      <ul class="footer-links">
        {footerNav.contact.map((l) => (
          <li>
            <a href={l.href} {...(isExternal(l.href) ? { target: "_blank", rel: "noopener" } : {})}>{l.label}</a>
          </li>
        ))}
      </ul>
    </div>

    <div>
      <div class="footer-col-title">Hours</div>
      <div class="footer-hours">
        Check the app or<br />
        ZenPlanner for current<br />
        class schedule &amp; times.
      </div>
      <div style="margin-top:24px;">
        <a href={site.bookingUrl} class="btn-primary" style="font-size:.75rem;padding:12px 24px;" target="_blank" rel="noopener">Book Now</a>
      </div>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="footer-copy">© {year} {site.name} · All Rights Reserved</div>
    <div class="footer-social">
      <a href={site.instagram.url} target="_blank" rel="noopener">{site.instagram.handle}</a>
    </div>
  </div>
</footer>

<style>
  footer {
    background: var(--dark-3);
    padding: 80px 48px 40px;
  }
  .footer-top {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: 60px;
    padding-bottom: 60px;
    border-bottom: 1px solid rgba(241, 231, 212, 0.1);
    margin-bottom: 40px;
    max-width: var(--content-max);
    margin-left: auto;
    margin-right: auto;
  }
  .brand-name {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 900;
    color: var(--cream);
    margin-bottom: 12px;
  }
  .brand-tagline {
    font-size: 0.85rem;
    opacity: 0.45;
    line-height: 1.6;
    max-width: 260px;
    margin-bottom: 24px;
    color: var(--cream);
  }
  .footer-address {
    font-size: 0.82rem;
    opacity: 0.55;
    line-height: 1.8;
    color: var(--cream);
    font-style: normal;
  }
  .footer-email {
    color: var(--coral);
    text-decoration: none;
  }
  .footer-col-title {
    font-family: var(--font-stamp);
    font-size: 0.8rem;
    letter-spacing: 0.2em;
    color: var(--coral);
    margin-bottom: 20px;
  }
  .footer-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .footer-links a {
    color: var(--cream);
    text-decoration: none;
    font-size: 0.83rem;
    opacity: 0.55;
    transition: opacity 0.2s, color 0.2s;
  }
  .footer-links a:hover {
    opacity: 1;
    color: var(--coral);
  }
  .footer-hours {
    font-size: 0.82rem;
    opacity: 0.55;
    line-height: 2;
    color: var(--cream);
  }
  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    max-width: var(--content-max);
    margin: 0 auto;
  }
  .footer-copy {
    font-size: 0.75rem;
    opacity: 0.3;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .footer-social a {
    color: var(--cream);
    text-decoration: none;
    font-size: 0.75rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    opacity: 0.4;
    transition: opacity 0.2s, color 0.2s;
  }
  .footer-social a:hover {
    opacity: 1;
    color: var(--coral);
  }

  @media (max-width: 900px) {
    footer {
      padding-left: 24px;
      padding-right: 24px;
    }
    .footer-top {
      grid-template-columns: 1fr 1fr;
      gap: 40px;
    }
  }
  @media (max-width: 560px) {
    .footer-top {
      grid-template-columns: 1fr;
    }
    .footer-bottom {
      flex-direction: column;
      gap: 12px;
      align-items: flex-start;
    }
  }
</style>
