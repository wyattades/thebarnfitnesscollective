---
/**
 * CommunitySection — "More than a gym, a collective" Instagram photo grid.
 * Shows real photos from @thebarnfitnesscollective (see src/data/instagram.ts).
 * Every tile links out to the Instagram profile.
 */
import Img from "./Img.astro";
import { site } from "../data/site";
import { instaPosts } from "../data/instagram";
---

<section class="section-community">
  <div class="section-header fade-up community-header">
    <div class="section-eyebrow">The Community</div>
    <h2 class="section-title">More than a gym,<br /><em>a collective.</em></h2>
  </div>
  <div class="insta-grid">
    {
      instaPosts.map((post) => (
        <a
          class="insta-item"
          href={post.link || site.instagram.url}
          target="_blank"
          rel="noopener"
          aria-label={`${post.alt} — view on Instagram`}
        >
          <Img name={post.image} alt={post.alt} class="insta-img" width={500} />
          <div class="insta-overlay"><span class="insta-icon">↗</span></div>
        </a>
      ))
    }
  </div>
  <a class="community-follow" href={site.instagram.url} target="_blank" rel="noopener">
    Follow us {site.instagram.handle}
  </a>
</section>

<style>
  .section-community {
    background: var(--dark);
    padding: 100px 48px;
  }
  .community-header {
    max-width: var(--content-max);
    margin-left: auto;
    margin-right: auto;
  }
  .insta-grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 10px;
    margin-top: 56px;
    max-width: var(--content-max);
    margin-left: auto;
    margin-right: auto;
  }
  .insta-item {
    aspect-ratio: 1;
    position: relative;
    overflow: hidden;
    cursor: pointer;
    background: var(--dark-2);
    display: block;
    border-radius: var(--radius-sm);
  }
  .insta-item :global(.insta-img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 0.5s;
  }
  .insta-item:hover :global(.insta-img) {
    transform: scale(1.08);
  }
  .insta-overlay {
    position: absolute;
    inset: 0;
    background: rgba(23, 18, 19, 0.55);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.3s;
  }
  .insta-item:hover .insta-overlay {
    opacity: 1;
  }
  .insta-icon {
    font-size: 1.8rem;
    color: var(--cream);
  }
  .community-follow {
    display: flex;
    width: fit-content;
    margin: 32px auto 0;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--cream);
    text-decoration: none;
    padding: 12px 26px;
    border: 1.5px solid rgba(241, 231, 212, 0.28);
    border-radius: var(--radius-pill);
    transition: border-color 0.2s, color 0.2s, background 0.2s;
  }
  .community-follow:hover {
    color: var(--coral);
    border-color: var(--coral);
    background: rgba(255, 111, 100, 0.06);
  }
  @media (max-width: 900px) {
    .section-community {
      padding-left: 24px;
      padding-right: 24px;
    }
    .insta-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
