---
/**
 * AppSection — "Download the app" with store buttons + phone mockups.
 * The Barn app is powered by ZenPlanner. Store links come from src/data/site.ts.
 */
import { site } from "../data/site";
---

<section class="section-app">
  <div class="app-inner">
    <div class="app-copy">
      <div class="app-eyebrow">Ready to Train?</div>
      <h2 class="app-title">Download <em>the app.</em></h2>
      <p class="app-body">
        Book classes, manage your membership, track your progress — all from your
        pocket. The Barn app powered by ZenPlanner is available on iOS and
        Android.
      </p>
      <div class="app-buttons">
        <a href={site.app.ios} class="app-store-btn" target="_blank" rel="noopener">
          <svg width="22" height="26" viewBox="0 0 22 26" fill="none" aria-hidden="true">
            <path d="M18.1 13.6c0-3.5 2.9-5.2 3-5.3-1.6-2.4-4.2-2.7-5.1-2.7-2.2-.2-4.2 1.3-5.3 1.3-1.1 0-2.8-1.2-4.6-1.2C3.5 5.8.7 7.7.7 11.8c0 2.5.9 5.1 2.1 6.8 1 1.5 2.1 3.1 3.6 3 1.5-.1 2-.9 3.8-.9 1.8 0 2.3.9 3.9.9 1.6 0 2.6-1.5 3.6-3 1.1-1.7 1.6-3.4 1.6-3.5-.1.1-3.3-1.5-3.3-5.5zM14.9 3.5c.9-1 1.4-2.4 1.3-3.5-1.2.1-2.7.8-3.6 1.8-.8.9-1.5 2.3-1.3 3.4 1.3.2 2.7-.5 3.6-1.7z" fill="#F1E7D4"></path>
          </svg>
          <div>
            <div class="abt">Download on the</div>
            <div class="abn">App Store</div>
          </div>
        </a>
        <a href={site.app.android} class="app-store-btn" target="_blank" rel="noopener">
          <svg width="22" height="24" viewBox="0 0 22 24" fill="none" aria-hidden="true">
            <path d="M1.2.7C.8.9.5 1.5.5 2.2v19.6c0 .7.3 1.3.7 1.5l.1.1 11-11v-.3L1.3.7 1.2.7z" fill="#F1E7D4" opacity=".8"></path>
            <path d="M15.9 15.8l-3.7-3.7v-.2l3.7-3.7.1.1 4.4 2.5c1.2.7 1.2 1.8 0 2.5l-4.5 2.5z" fill="#F1E7D4"></path>
          </svg>
          <div>
            <div class="abt">Get it on</div>
            <div class="abn">Google Play</div>
          </div>
        </a>
      </div>
    </div>

    <div class="app-phones">
      <div class="phone-mockup">
        <div class="phone-screen">
          <div class="phone-screen-header">
            <div class="psh-label">The Barn</div>
            <div class="psh-title">Book a Class</div>
          </div>
          <div class="phone-classes">
            <div class="pc-item">
              <div class="pc-time">MON · 6:00 AM</div>
              <div class="pc-name">Body Armor</div>
            </div>
            <div class="pc-item teal">
              <div class="pc-time">TUE · 5:30 PM</div>
              <div class="pc-name">Build + Blast</div>
            </div>
            <div class="pc-item sky">
              <div class="pc-time">FRI · 9:00 AM</div>
              <div class="pc-name">Pump Party</div>
            </div>
            <div class="pc-item">
              <div class="pc-time">SAT · 8:00 AM</div>
              <div class="pc-name">Hybrid Hustle</div>
            </div>
          </div>
        </div>
      </div>
      <div class="phone-mockup">
        <div class="phone-screen">
          <div class="phone-screen-header teal-header">
            <div class="psh-label">My Membership</div>
            <div class="psh-title">Unlimited Plan</div>
          </div>
          <div class="phone-classes">
            <div class="pc-stat">
              <div class="pc-stat-label">NEXT CLASS</div>
              <div class="pc-stat-value">Body Armor</div>
              <div class="pc-stat-sub">Tomorrow · 6:00 AM</div>
            </div>
            <div class="pc-stat">
              <div class="pc-stat-label">THIS MONTH</div>
              <div class="pc-stat-big">12 classes</div>
              <div class="pc-bar"><div class="pc-bar-fill"></div></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .section-app {
    background: var(--rust);
    padding: 100px 48px;
    position: relative;
    overflow: hidden;
  }
  .section-app::before {
    content: "";
    position: absolute;
    right: -100px;
    top: -100px;
    width: 500px;
    height: 500px;
    border-radius: 50%;
    background: rgba(255, 111, 100, 0.2);
  }
  .section-app::after {
    content: "";
    position: absolute;
    left: -50px;
    bottom: -50px;
    width: 300px;
    height: 300px;
    border-radius: 50%;
    background: rgba(38, 38, 38, 0.15);
  }
  .app-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: center;
    position: relative;
    z-index: 2;
    max-width: var(--content-max);
    margin: 0 auto;
  }
  .app-eyebrow {
    font-family: var(--font-stamp);
    font-size: 0.85rem;
    letter-spacing: 0.3em;
    color: rgba(241, 231, 212, 0.6);
    margin-bottom: 16px;
  }
  .app-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 3.5rem);
    font-weight: 900;
    color: var(--cream);
    line-height: 1.05;
    margin-bottom: 20px;
  }
  .app-title em {
    font-style: italic;
    color: var(--sky);
  }
  .app-body {
    font-size: 1rem;
    line-height: 1.7;
    color: rgba(241, 231, 212, 0.75);
    margin-bottom: 40px;
  }
  .app-buttons {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }
  .app-store-btn {
    display: flex;
    align-items: center;
    gap: 10px;
    background: var(--dark);
    color: var(--cream);
    text-decoration: none;
    padding: 12px 24px;
    border-radius: var(--radius);
    transition: background 0.2s;
  }
  .app-store-btn:hover {
    background: #3a3a3a;
  }
  .app-store-btn .abt {
    font-size: 0.6rem;
    opacity: 0.6;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  .app-store-btn .abn {
    font-size: 0.95rem;
    font-weight: 700;
    margin-top: 1px;
  }
  .app-phones {
    display: flex;
    gap: 20px;
    justify-content: center;
    align-items: flex-end;
  }
  .phone-mockup {
    width: 160px;
    background: var(--dark);
    border-radius: 28px;
    padding: 12px;
    box-shadow: 0 40px 80px rgba(0, 0, 0, 0.4);
    border: 2px solid rgba(255, 255, 255, 0.1);
  }
  .phone-mockup:first-child {
    transform: rotate(-4deg) translateY(20px);
    width: 145px;
  }
  .phone-screen {
    background: var(--dark-2);
    border-radius: 18px;
    aspect-ratio: 9 / 19;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }
  .phone-screen-header {
    background: var(--rust);
    padding: 14px 12px 10px;
  }
  .phone-screen-header.teal-header {
    background: var(--teal);
  }
  .psh-label {
    font-size: 0.55rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    opacity: 0.6;
    color: var(--cream);
  }
  .psh-title {
    font-family: var(--font-display);
    font-size: 0.85rem;
    font-weight: 900;
    color: var(--cream);
  }
  .phone-classes {
    padding: 10px;
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .pc-item {
    background: rgba(255, 255, 255, 0.05);
    border-radius: 6px;
    padding: 8px 10px;
    border-left: 3px solid var(--coral);
  }
  .pc-item.teal {
    border-color: var(--teal);
  }
  .pc-item.sky {
    border-color: var(--sky);
  }
  .pc-time {
    font-size: 0.5rem;
    opacity: 0.5;
    letter-spacing: 0.1em;
  }
  .pc-name {
    font-size: 0.65rem;
    font-weight: 600;
    color: var(--cream);
    margin-top: 1px;
  }
  .pc-stat {
    padding: 8px 10px;
    background: rgba(255, 255, 255, 0.05);
    border-radius: 6px;
  }
  .pc-stat-label {
    font-size: 0.5rem;
    opacity: 0.5;
    letter-spacing: 0.1em;
  }
  .pc-stat-value {
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--cream);
    margin-top: 2px;
  }
  .pc-stat-sub {
    font-size: 0.55rem;
    color: var(--coral);
    margin-top: 2px;
  }
  .pc-stat-big {
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--cream);
    margin-top: 2px;
  }
  .pc-bar {
    background: rgba(255, 255, 255, 0.1);
    border-radius: 10px;
    height: 4px;
    margin-top: 6px;
    overflow: hidden;
  }
  .pc-bar-fill {
    background: var(--coral);
    width: 75%;
    height: 100%;
    border-radius: 10px;
  }
  @media (max-width: 900px) {
    .section-app {
      padding-left: 24px;
      padding-right: 24px;
    }
    .app-inner {
      grid-template-columns: 1fr;
      gap: 48px;
    }
  }
</style>
