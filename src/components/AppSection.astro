---
/**
 * AppSection — "Download the app" with store buttons + phone mockups.
 * The Barn app is powered by ZenPlanner. Store links come from src/data/site.ts.
 */
import { site } from "../data/site";
---

<section class="section-app">
  <div class="app-inner">
    <div class="app-copy">
      <div class="app-eyebrow">Ready to Train?</div>
      <h2 class="app-title">Download <em>the app.</em></h2>
      <p class="app-body">
        Book classes, manage your membership, track your progress — all from your
        pocket. The Barn app powered by ZenPlanner is available on iOS and
        Android.
      </p>
      <div class="app-buttons">
        <a href={site.app.ios} class="app-store-btn" target="_blank" rel="noopener">
          <svg width="21" height="21" viewBox="0 0 24 24" fill="#F1E7D4" aria-hidden="true">
            <path d="M12.152 6.896c-.948 0-2.415-1.078-3.96-1.04-2.04.027-3.91 1.183-4.961 3.014-2.117 3.675-.546 9.103 1.519 12.09 1.013 1.454 2.208 3.09 3.792 3.039 1.52-.065 2.09-.987 3.935-.987 1.831 0 2.35.987 3.96.948 1.637-.026 2.676-1.48 3.676-2.948 1.156-1.688 1.636-3.325 1.662-3.415-.039-.013-3.182-1.221-3.22-4.857-.026-3.04 2.48-4.494 2.597-4.559-1.429-2.09-3.623-2.324-4.39-2.376-2-.156-3.675 1.09-4.61 1.09zM15.53 3.83c.843-1.012 1.4-2.427 1.245-3.83-1.207.052-2.662.805-3.532 1.818-.78.896-1.454 2.338-1.273 3.714 1.338.104 2.715-.688 3.559-1.701"></path>
          </svg>
          <div>
            <div class="abt">Download on the</div>
            <div class="abn">App Store</div>
          </div>
        </a>
        <a href={site.app.android} class="app-store-btn" target="_blank" rel="noopener">
          <svg width="21" height="21" viewBox="0 0 24 24" fill="#F1E7D4" aria-hidden="true">
            <path d="M22.018 13.298l-3.919 2.218-3.515-3.493 3.543-3.521 3.891 2.202a1.49 1.49 0 0 1 0 2.594zM1.337.924a1.486 1.486 0 0 0-.112.568v21.017c0 .217.045.419.124.6l11.155-11.087L1.337.924zm12.207 10.065l3.258-3.238L3.45.195a1.466 1.466 0 0 0-.946-.179l11.04 10.973zm0 2.067l-11 10.933c.298.036.612-.016.906-.183l13.324-7.54-3.23-3.21z"></path>
          </svg>
          <div>
            <div class="abt">Get it on</div>
            <div class="abn">Google Play</div>
          </div>
        </a>
      </div>
    </div>

    <div class="app-phones">
      <div class="phone-mockup">
        <div class="phone-screen">
          <div class="phone-screen-header">
            <div class="psh-label">The Barn</div>
            <div class="psh-title">Book a Class</div>
          </div>
          <div class="phone-classes">
            <div class="pc-item">
              <div class="pc-time">MON · 6:00 AM</div>
              <div class="pc-name">Body Armor</div>
            </div>
            <div class="pc-item teal">
              <div class="pc-time">TUE · 5:30 PM</div>
              <div class="pc-name">Build + Blast</div>
            </div>
            <div class="pc-item sky">
              <div class="pc-time">FRI · 9:00 AM</div>
              <div class="pc-name">Pump Party</div>
            </div>
            <div class="pc-item">
              <div class="pc-time">SAT · 8:00 AM</div>
              <div class="pc-name">Hybrid Hustle</div>
            </div>
          </div>
        </div>
      </div>
      <div class="phone-mockup">
        <div class="phone-screen">
          <div class="phone-screen-header teal-header">
            <div class="psh-label">My Membership</div>
            <div class="psh-title">Unlimited Plan</div>
          </div>
          <div class="phone-classes">
            <div class="pc-stat">
              <div class="pc-stat-label">NEXT CLASS</div>
              <div class="pc-stat-value">Body Armor</div>
              <div class="pc-stat-sub">Tomorrow · 6:00 AM</div>
            </div>
            <div class="pc-stat">
              <div class="pc-stat-label">THIS MONTH</div>
              <div class="pc-stat-big">12 classes</div>
              <div class="pc-bar"><div class="pc-bar-fill"></div></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .section-app {
    background: var(--rust);
    padding: 100px 48px;
    position: relative;
    overflow: hidden;
  }
  .section-app::before {
    content: "";
    position: absolute;
    right: -100px;
    top: -100px;
    width: 500px;
    height: 500px;
    border-radius: 50%;
    background: rgba(255, 111, 100, 0.2);
  }
  .section-app::after {
    content: "";
    position: absolute;
    left: -50px;
    bottom: -50px;
    width: 300px;
    height: 300px;
    border-radius: 50%;
    background: rgba(23, 18, 19, 0.15);
  }
  .app-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: center;
    position: relative;
    z-index: 2;
    max-width: var(--content-max);
    margin: 0 auto;
  }
  .app-eyebrow {
    display: inline-block;
    font-family: var(--font-stamp);
    font-size: 0.85rem;
    letter-spacing: 0.28em;
    color: var(--cream);
    margin-bottom: 20px;
    padding: 7px 18px 5px;
    border: 1px solid rgba(241, 231, 212, 0.4);
    border-radius: var(--radius-pill);
  }
  .app-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 3.5rem);
    font-weight: 500;
    color: var(--cream);
    line-height: 1.05;
    margin-bottom: 20px;
  }
  .app-title em {
    font-style: italic;
    color: var(--sky);
  }
  .app-body {
    font-size: 1rem;
    line-height: 1.7;
    color: rgba(241, 231, 212, 0.75);
    margin-bottom: 40px;
  }
  .app-buttons {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }
  .app-store-btn {
    display: flex;
    align-items: center;
    gap: 10px;
    background: var(--dark);
    color: var(--cream);
    text-decoration: none;
    padding: 12px 24px;
    border-radius: var(--radius);
    transition: background 0.2s;
  }
  .app-store-btn:hover {
    background: var(--plum);
  }
  .app-store-btn .abt {
    font-size: 0.6rem;
    opacity: 0.6;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  .app-store-btn .abn {
    font-size: 0.95rem;
    font-weight: 700;
    margin-top: 1px;
  }
  .app-phones {
    display: flex;
    gap: 20px;
    justify-content: center;
    align-items: flex-end;
  }
  .phone-mockup {
    width: 160px;
    background: var(--dark);
    border-radius: 28px;
    padding: 12px;
    box-shadow: 0 40px 80px rgba(0, 0, 0, 0.4);
    border: 2px solid rgba(255, 255, 255, 0.1);
  }
  .phone-mockup:first-child {
    transform: rotate(-4deg) translateY(20px);
    width: 145px;
  }
  .phone-screen {
    background: var(--dark-2);
    border-radius: 18px;
    aspect-ratio: 9 / 19;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }
  .phone-screen-header {
    background: var(--rust);
    padding: 14px 12px 10px;
  }
  .phone-screen-header.teal-header {
    background: var(--teal);
  }
  .psh-label {
    font-size: 0.55rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    opacity: 0.6;
    color: var(--cream);
  }
  .psh-title {
    font-family: var(--font-display);
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--cream);
  }
  .phone-classes {
    padding: 10px;
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .pc-item {
    background: rgba(255, 255, 255, 0.05);
    border-radius: 6px;
    padding: 8px 10px;
    border-left: 3px solid var(--coral);
  }
  .pc-item.teal {
    border-color: var(--teal);
  }
  .pc-item.sky {
    border-color: var(--sky);
  }
  .pc-time {
    font-size: 0.5rem;
    opacity: 0.5;
    letter-spacing: 0.1em;
  }
  .pc-name {
    font-size: 0.65rem;
    font-weight: 600;
    color: var(--cream);
    margin-top: 1px;
  }
  .pc-stat {
    padding: 8px 10px;
    background: rgba(255, 255, 255, 0.05);
    border-radius: 6px;
  }
  .pc-stat-label {
    font-size: 0.5rem;
    opacity: 0.5;
    letter-spacing: 0.1em;
  }
  .pc-stat-value {
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--cream);
    margin-top: 2px;
  }
  .pc-stat-sub {
    font-size: 0.55rem;
    color: var(--coral);
    margin-top: 2px;
  }
  .pc-stat-big {
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--cream);
    margin-top: 2px;
  }
  .pc-bar {
    background: rgba(255, 255, 255, 0.1);
    border-radius: 10px;
    height: 4px;
    margin-top: 6px;
    overflow: hidden;
  }
  .pc-bar-fill {
    background: var(--coral);
    width: 75%;
    height: 100%;
    border-radius: 10px;
  }
  @media (max-width: 900px) {
    .section-app {
      padding-left: 24px;
      padding-right: 24px;
    }
    .app-inner {
      grid-template-columns: 1fr;
      gap: 48px;
    }
  }
</style>
