---
/**
 * NewHerePopup — a lead-capture pop-up that opens a few seconds after someone
 * lands on the site. It shows the same "Book Your First Class" form as /new-here.
 *
 * - Opens after `delayMs` (10s on desktop, `mobileDelayMs` = 20s on phones).
 *   The form is only loaded when the pop-up opens, so it adds nothing to
 *   page speed.
 * - Closing it (X, Esc, or clicking outside) hides it for `snoozeDays` days.
 * - Not shown on pages that are already about signing up (/new-here, /schedule).
 * - Fully keyboard accessible: focus moves into the dialog, Tab stays inside it,
 *   Esc closes, and focus returns to where it was.
 *
 * Tweak the numbers below to change the timing.
 */
import { site } from "../data/site";

const delayMs = 10_000;
const mobileDelayMs = 20_000;
const snoozeDays = 7;

const path = Astro.url.pathname.replace(/\/+$/, "") || "/";
const skip = ["/new-here", "/schedule"].includes(path);
---

{
  !skip && (
    <div
      id="newHerePopup"
      class="nhp"
      hidden
      data-delay={delayMs}
      data-mobile-delay={mobileDelayMs}
      data-snooze-days={snoozeDays}
      data-form-url={site.leadFormUrl}
    >
      <div class="nhp-backdrop" data-nhp-close></div>
      <div class="nhp-panel" role="dialog" aria-modal="true" aria-label="New here? Book your first class">
        <button type="button" class="nhp-close" aria-label="Close" data-nhp-close>
          <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true">
            <path d="M3 3l12 12M15 3L3 15" stroke="currentColor" stroke-width="2" stroke-linecap="round" fill="none" />
          </svg>
        </button>
        <div class="nhp-body">
          <div class="nhp-loading">Loading…</div>
        </div>
      </div>
    </div>
  )
}

<script>
  const popup = document.getElementById("newHerePopup") as HTMLElement | null;

  if (popup) {
    const KEY = "barn_newhere_popup_until";
    const isPhone = window.matchMedia("(max-width: 600px)").matches;
    const delay = isPhone
      ? Number(popup.dataset.mobileDelay) || 20000
      : Number(popup.dataset.delay) || 10000;
    const snoozeMs = (Number(popup.dataset.snoozeDays) || 7) * 24 * 60 * 60 * 1000;
    const formUrl = popup.dataset.formUrl || "";
    const panel = popup.querySelector<HTMLElement>(".nhp-panel")!;
    const body = popup.querySelector<HTMLElement>(".nhp-body")!;
    const closeBtn = popup.querySelector<HTMLElement>(".nhp-close")!;
    let opener: Element | null = null;
    let loaded = false;

    const snoozed = () => {
      try {
        return Number(localStorage.getItem(KEY) || 0) > Date.now();
      } catch {
        return false;
      }
    };
    const snooze = () => {
      try {
        localStorage.setItem(KEY, String(Date.now() + snoozeMs));
      } catch {}
    };
    const track = (name: string) => {
      try {
        (window as any).gtag?.("event", name);
      } catch {}
    };

    const loadForm = () => {
      if (loaded) return;
      loaded = true;
      const iframe = document.createElement("iframe");
      iframe.className = "nhp-iframe";
      iframe.id = "glofox_popup_form";
      iframe.src = formUrl;
      iframe.title = "New member sign-up form";
      iframe.setAttribute("scrolling", "auto");
      iframe.setAttribute("frameborder", "0");
      iframe.width = "100%";
      iframe.height = "560";
      body.innerHTML = "";
      body.appendChild(iframe);

      // Let the form grow to fit its content (same helper the embed code uses).
      const s = document.createElement("script");
      s.src = "https://cdnjs.cloudflare.com/ajax/libs/iframe-resizer/3.6.1/iframeResizer.min.js";
      s.onload = () => {
        try {
          (window as any).iFrameResize(
            {
              log: false,
              checkOrigin: false,
              tolerance: 0,
              sizeHeight: true,
              heightCalculationMethod: "lowestElement",
              minHeight: 300,
              maxHeight: 1800,
              sizeWidth: false,
              scrolling: "auto",
            },
            "#glofox_popup_form",
          );
        } catch {}
      };
      document.head.appendChild(s);
    };

    const focusables = () =>
      Array.from(
        panel.querySelectorAll<HTMLElement>('button, a[href], iframe, [tabindex]:not([tabindex="-1"])'),
      );

    const onKey = (e: KeyboardEvent) => {
      if (e.key === "Escape") {
        close();
        return;
      }
      if (e.key !== "Tab") return;
      const items = focusables();
      if (!items.length) return;
      const first = items[0];
      const last = items[items.length - 1];
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    };

    const open = () => {
      if (!popup.hidden || snoozed()) return;
      // Don't interrupt if another dialog/menu is already open.
      if (document.querySelector('.mobile-menu:not([hidden])')) return;
      opener = document.activeElement;
      popup.hidden = false;
      document.body.style.overflow = "hidden";
      loadForm();
      closeBtn.focus();
      document.addEventListener("keydown", onKey);
      track("new_here_popup_shown");
    };

    const close = () => {
      if (popup.hidden) return;
      popup.hidden = true;
      document.body.style.overflow = "";
      document.removeEventListener("keydown", onKey);
      snooze();
      track("new_here_popup_closed");
      (opener as HTMLElement | null)?.focus?.();
    };

    popup.querySelectorAll("[data-nhp-close]").forEach((el) => el.addEventListener("click", close));

    if (!snoozed()) setTimeout(open, delay);
  }
</script>

<style>
  .nhp {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
  }
  .nhp-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(19, 15, 16, 0.78);
    backdrop-filter: blur(3px);
  }
  .nhp-panel {
    position: relative;
    width: 100%;
    max-width: 480px;
    max-height: calc(100vh - 40px);
    max-height: calc(100dvh - 40px);
    overflow-y: auto;
    background: #fff;
    border-radius: var(--radius);
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.5);
  }
  .nhp-close {
    position: sticky;
    top: 10px;
    float: right;
    margin: 10px 10px -40px 0;
    z-index: 2;
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: none;
    border-radius: 50%;
    background: rgba(33, 26, 27, 0.08);
    color: #211a1b;
    cursor: pointer;
    transition: background 0.2s;
  }
  .nhp-close:hover {
    background: rgba(33, 26, 27, 0.18);
  }
  .nhp-close:focus-visible {
    outline: 2px solid var(--coral);
    outline-offset: 2px;
  }
  .nhp-body {
    min-height: 200px;
  }
  .nhp-loading {
    padding: 80px 24px;
    text-align: center;
    color: #6b5f60;
    font-size: 0.95rem;
  }
  .nhp :global(.nhp-iframe) {
    display: block;
    width: 100%;
    border: 0;
  }
  @media (max-width: 600px) {
    .nhp {
      padding: 10px;
    }
    .nhp-panel {
      max-height: calc(100dvh - 20px);
    }
  }
</style>
