---
/**
 * Global site header — solid charcoal bar, fixed to the top. Nav items come from
 * src/data/site.ts (mainNav). The link for the current page is highlighted.
 * Collapses to a mobile menu below 1040px.
 */
import { mainNav, site } from "../data/site";
import { getImageByName } from "../lib/images";
import { Image } from "astro:assets";

const goat = getImageByName("goat-logo.png");
const isExternal = (href: string) => /^https?:\/\//.test(href) || href.startsWith("mailto:");
const norm = (p: string) => (p.replace(/\/+$/, "") || "/");
const current = norm(Astro.url.pathname);
const isActive = (href: string) => !isExternal(href) && norm(href) === current;
---

<header id="mainNav">
  <a class="nav-logo" href="/" aria-label={`${site.name} — home`}>
    <Image src={goat} alt="" class="logo-mark" width={88} loading="eager" />
  </a>

  <nav aria-label="Primary">
    <ul class="nav-links">
      {
        mainNav.map((item) => (
          <li class:list={{ "has-dropdown": item.children }}>
            <a
              href={item.href}
              class:list={{ active: isActive(item.href) }}
              aria-current={isActive(item.href) ? "page" : undefined}
              {...(isExternal(item.href) ? { target: "_blank", rel: "noopener" } : {})}
            >
              {item.label}
            </a>
            {item.children && (
              <ul class="nav-dropdown">
                {item.children.map((child) => (
                  <li>
                    <a href={child.href} class:list={{ active: isActive(child.href) }}>
                      {child.label}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))
      }
    </ul>
  </nav>

  <button class="nav-toggle" aria-label="Open menu" aria-expanded="false" aria-controls="mobileMenu">
    <span class="bar top-bun"></span>
    <span class="bar patty"></span>
    <span class="bar bottom-bun"></span>
  </button>
</header>

<div class="mobile-menu" id="mobileMenu" hidden>
  <ul>
    {
      mainNav.map((item) => (
        <>
          <li>
            <a
              href={item.href}
              class:list={{ active: isActive(item.href) }}
              aria-current={isActive(item.href) ? "page" : undefined}
              {...(isExternal(item.href) ? { target: "_blank", rel: "noopener" } : {})}
            >
              {item.label}
            </a>
          </li>
          {item.children?.map((child) => (
            <li class="mobile-submenu-item">
              <a href={child.href} class:list={{ active: isActive(child.href) }}>
                {child.label}
              </a>
            </li>
          ))}
        </>
      ))
    }
  </ul>
</div>

<style>
  #mainNav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    min-height: var(--header-height);
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 48px;
    /* Solid dark bar, always visible (including over the bright video hero). */
    background: rgba(23, 18, 19, 0.97);
    backdrop-filter: blur(10px);
    transition: box-shadow 0.3s;
  }
  #mainNav.scrolled {
    box-shadow: 0 1px 0 rgba(241, 231, 212, 0.08), 0 8px 24px rgba(0, 0, 0, 0.35);
  }

  .nav-logo {
    display: flex;
    align-items: center;
    text-decoration: none;
  }
  .nav-logo :global(.logo-mark) {
    width: 44px;
    height: 44px;
    object-fit: contain;
  }

  .nav-links {
    display: flex;
    gap: 2px;
    list-style: none;
    align-items: center;
  }
  /* Each nav item is a rounded pill chip that fills in on hover / when active. */
  .nav-links a {
    display: inline-block;
    white-space: nowrap;
    color: var(--cream);
    text-decoration: none;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    opacity: 0.85;
    padding: 9px 13px;
    border-radius: var(--radius-pill);
    border: 1px solid transparent;
    transition: opacity 0.2s, color 0.2s, background 0.2s, border-color 0.2s;
  }
  .nav-links a:hover {
    opacity: 1;
    color: #2a1210;
    background: var(--coral);
    border-color: var(--coral);
  }
  /* Current page: filled coral pill. */
  .nav-links a.active {
    opacity: 1;
    color: #2a1210;
    background: var(--coral);
    border-color: var(--coral);
  }

  /* Dropdown (e.g. Programming & Pricing → Our Menu). */
  .nav-links li.has-dropdown {
    position: relative;
  }
  .nav-dropdown {
    position: absolute;
    top: 100%;
    left: 0;
    margin-top: 6px;
    min-width: 160px;
    list-style: none;
    background: rgba(23, 18, 19, 0.98);
    border: 1px solid rgba(241, 231, 212, 0.14);
    border-radius: var(--radius);
    padding: 6px;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-4px);
    transition: opacity 0.18s, transform 0.18s, visibility 0.18s;
  }
  .nav-links li.has-dropdown:hover .nav-dropdown,
  .nav-links li.has-dropdown:focus-within .nav-dropdown {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }
  .nav-dropdown a {
    display: block;
    width: 100%;
    padding: 9px 12px;
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    border-radius: var(--radius-sm);
    white-space: nowrap;
  }

  /* Hamburger */
  .nav-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 6px;
  }
  .nav-toggle .bar {
    width: 26px;
    height: 3px;
    background: var(--cream);
    border-radius: 2px;
    transition: transform 0.3s, opacity 0.3s;
  }
  .nav-toggle[aria-expanded="true"] .top-bun {
    transform: translateY(8px) rotate(45deg);
  }
  .nav-toggle[aria-expanded="true"] .patty {
    opacity: 0;
  }
  .nav-toggle[aria-expanded="true"] .bottom-bun {
    transform: translateY(-8px) rotate(-45deg);
  }

  .mobile-menu {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 99;
    padding: 90px 24px 32px;
    background: rgba(23, 18, 19, 0.98);
    backdrop-filter: blur(10px);
  }
  .mobile-menu ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .mobile-menu a {
    display: block;
    color: var(--cream);
    text-decoration: none;
    font-size: 0.9rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 14px 4px;
    border-bottom: 1px solid rgba(241, 231, 212, 0.08);
  }
  .mobile-menu a:hover,
  .mobile-menu a.active {
    color: var(--coral);
  }
  .mobile-submenu-item a {
    padding-left: 22px;
    font-size: 0.78rem;
    opacity: 0.8;
  }

  /* Tighten spacing on mid widths before collapsing to the mobile menu. */
  @media (max-width: 1140px) {
    #mainNav {
      padding: 0 28px;
    }
    .nav-links {
      gap: 3px;
    }
    .nav-links a {
      font-size: 0.7rem;
      letter-spacing: 0.06em;
      padding: 8px 11px;
    }
  }
  @media (max-width: 1040px) {
    #mainNav {
      padding: 16px 24px;
    }
    .nav-links {
      display: none;
    }
    .nav-toggle {
      display: flex;
    }
  }
</style>

<script>
  // Charcoal background once scrolled past the hero top.
  const nav = document.getElementById("mainNav");
  const onScroll = () => nav?.classList.toggle("scrolled", window.scrollY > 60);
  window.addEventListener("scroll", onScroll, { passive: true });
  onScroll();

  // Mobile menu toggle.
  const toggle = document.querySelector<HTMLButtonElement>(".nav-toggle");
  const menu = document.getElementById("mobileMenu");
  toggle?.addEventListener("click", () => {
    const open = toggle.getAttribute("aria-expanded") === "true";
    toggle.setAttribute("aria-expanded", String(!open));
    toggle.setAttribute("aria-label", open ? "Open menu" : "Close menu");
    if (menu) menu.hidden = open;
  });
</script>
