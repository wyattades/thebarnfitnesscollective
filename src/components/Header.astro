---
/**
 * Global site header. Transparent over the hero, fades to charcoal on scroll.
 * Nav items come from src/data/site.ts (mainNav). Collapses to a mobile menu.
 */
import { mainNav, site } from "../data/site";
import { getImageByName } from "../lib/images";
import { Image } from "astro:assets";

const goat = getImageByName("goat-logo.png");
const isExternal = (href: string) => /^https?:\/\//.test(href) || href.startsWith("mailto:");
---

<header id="mainNav">
  <a class="nav-logo" href="/" aria-label={`${site.name} — home`}>
    <Image src={goat} alt="" class="logo-mark" width={72} loading="eager" />
    <span>The Barn</span>
  </a>

  <nav aria-label="Primary">
    <ul class="nav-links">
      {
        mainNav.map((item, i) => (
          <li>
            <a
              href={item.href}
              class={i === 0 ? "nav-cta" : ""}
              {...(isExternal(item.href) ? { target: "_blank", rel: "noopener" } : {})}
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <button class="nav-toggle" aria-label="Open menu" aria-expanded="false" aria-controls="mobileMenu">
    <span class="bar top-bun"></span>
    <span class="bar patty"></span>
    <span class="bar bottom-bun"></span>
  </button>
</header>

<div class="mobile-menu" id="mobileMenu" hidden>
  <ul>
    {
      mainNav.map((item) => (
        <li>
          <a href={item.href} {...(isExternal(item.href) ? { target: "_blank", rel: "noopener" } : {})}>
            {item.label}
          </a>
        </li>
      ))
    }
  </ul>
</div>

<style>
  #mainNav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    min-height: var(--header-height);
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 48px;
    /* Solid dark bar, always visible (including over the bright video hero). */
    background: rgba(38, 38, 38, 0.97);
    backdrop-filter: blur(10px);
    transition: box-shadow 0.3s;
  }
  #mainNav.scrolled {
    box-shadow: 0 1px 0 rgba(241, 231, 212, 0.08), 0 8px 24px rgba(0, 0, 0, 0.35);
  }

  .nav-logo {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 900;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--cream);
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .nav-logo :global(.logo-mark) {
    width: 36px;
    height: 36px;
    object-fit: contain;
  }

  .nav-links {
    display: flex;
    gap: 28px;
    list-style: none;
    align-items: center;
  }
  .nav-links a {
    color: var(--cream);
    text-decoration: none;
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0.85;
    transition: opacity 0.2s, color 0.2s;
  }
  .nav-links a:hover {
    opacity: 1;
    color: var(--coral);
  }
  .nav-cta {
    background: var(--coral);
    color: var(--dark) !important;
    padding: 10px 20px;
    border-radius: var(--radius-sm);
    font-weight: 700 !important;
    opacity: 1 !important;
    transition: background 0.2s !important;
  }
  .nav-cta:hover {
    background: var(--rust) !important;
    color: var(--cream) !important;
  }

  /* Hamburger */
  .nav-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 6px;
  }
  .nav-toggle .bar {
    width: 26px;
    height: 3px;
    background: var(--cream);
    border-radius: 2px;
    transition: transform 0.3s, opacity 0.3s;
  }
  .nav-toggle[aria-expanded="true"] .top-bun {
    transform: translateY(8px) rotate(45deg);
  }
  .nav-toggle[aria-expanded="true"] .patty {
    opacity: 0;
  }
  .nav-toggle[aria-expanded="true"] .bottom-bun {
    transform: translateY(-8px) rotate(-45deg);
  }

  .mobile-menu {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 99;
    padding: 90px 24px 32px;
    background: rgba(38, 38, 38, 0.98);
    backdrop-filter: blur(10px);
  }
  .mobile-menu ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .mobile-menu a {
    display: block;
    color: var(--cream);
    text-decoration: none;
    font-size: 0.9rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 14px 4px;
    border-bottom: 1px solid rgba(241, 231, 212, 0.08);
  }
  .mobile-menu a:hover {
    color: var(--coral);
  }

  /* Tighten spacing on mid widths before collapsing to the mobile menu. */
  @media (max-width: 1140px) {
    #mainNav {
      padding: 18px 32px;
    }
    .nav-links {
      gap: 20px;
    }
    .nav-links a {
      font-size: 0.72rem;
      letter-spacing: 0.08em;
    }
  }
  @media (max-width: 1040px) {
    #mainNav {
      padding: 16px 24px;
    }
    .nav-links {
      display: none;
    }
    .nav-toggle {
      display: flex;
    }
  }
</style>

<script>
  // Charcoal background once scrolled past the hero top.
  const nav = document.getElementById("mainNav");
  const onScroll = () => nav?.classList.toggle("scrolled", window.scrollY > 60);
  window.addEventListener("scroll", onScroll, { passive: true });
  onScroll();

  // Mobile menu toggle.
  const toggle = document.querySelector<HTMLButtonElement>(".nav-toggle");
  const menu = document.getElementById("mobileMenu");
  toggle?.addEventListener("click", () => {
    const open = toggle.getAttribute("aria-expanded") === "true";
    toggle.setAttribute("aria-expanded", String(!open));
    toggle.setAttribute("aria-label", open ? "Open menu" : "Close menu");
    if (menu) menu.hidden = open;
  });
</script>
