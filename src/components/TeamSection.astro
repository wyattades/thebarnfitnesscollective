---
/**
 * TeamSection — "Your coaches" heading + the grid of TeamMembers.
 * Content comes from src/data/team.ts (team).
 */
import TeamMember from "./TeamMember.astro";
import { team } from "../data/team";
---

<section id="team" class="section-team">
  <div class="team-header section-header fade-up">
    <div class="section-eyebrow">Meet the Team</div>
    <h2 class="section-title">Your <em>coaches.</em></h2>
    <p class="section-body team-intro">
      Our coaches bring credentials, heart, and a genuine love of helping people
      move better and feel stronger.
    </p>
  </div>
  <div class="team-grid">
    {team.map((coach) => <TeamMember {...coach} />)}
  </div>
</section>

<style>
  .section-team {
    background: var(--cream);
    color: var(--dark);
    padding: 120px 48px;
  }
  .team-header {
    max-width: var(--content-max);
    margin-left: auto;
    margin-right: auto;
  }
  .team-header :global(.section-title) {
    color: var(--dark);
  }
  .team-header :global(.section-title em) {
    color: var(--rust);
  }
  .team-header :global(.section-eyebrow) {
    color: var(--rust);
  }
  .team-header :global(.section-eyebrow::before) {
    background: var(--rust);
  }
  .team-intro {
    color: var(--dark);
    opacity: 0.6;
  }
  .team-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 24px;
    margin-top: 64px;
    max-width: var(--content-max);
    margin-left: auto;
    margin-right: auto;
  }
  @media (max-width: 900px) {
    .section-team {
      padding-left: 24px;
      padding-right: 24px;
    }
  }
</style>
