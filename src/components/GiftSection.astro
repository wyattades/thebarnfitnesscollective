---
/**
 * GiftSection — teal "Gift Card" call-to-action strip.
 */
import { site } from "../data/site";
---

<section class="section-gift">
  <div class="gift-eyebrow">Give the Gift of Strength</div>
  <h2 class="gift-title">The Barn <em>Gift Card</em></h2>
  <p class="gift-body">
    Looking for the perfect gift? Share the stoke. Email us with the recipient's
    name and occasion and we'll send a personalized gift card.
  </p>
  <a
    href={`mailto:${site.email}?subject=Gift Card Request`}
    class="gift-btn">Request a Gift Card</a>
</section>

<style>
  .section-gift {
    background: var(--teal);
    padding: 80px 48px;
    text-align: center;
  }
  .gift-eyebrow {
    font-family: var(--font-stamp);
    font-size: 0.85rem;
    letter-spacing: 0.35em;
    color: rgba(241, 231, 212, 0.65);
    margin-bottom: 16px;
  }
  .gift-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 4rem);
    font-weight: 500;
    color: var(--cream);
    margin-bottom: 16px;
  }
  .gift-title em {
    font-style: italic;
    color: var(--cream);
    opacity: 0.75;
  }
  .gift-body {
    font-size: 1rem;
    opacity: 0.75;
    color: var(--cream);
    max-width: 500px;
    margin: 0 auto 36px;
    line-height: 1.6;
  }
  .gift-btn {
    display: inline-block;
    background: var(--dark);
    color: var(--cream);
    text-decoration: none;
    font-weight: 700;
    font-size: 0.85rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    padding: 18px 44px;
    border-radius: var(--radius-sm);
    transition: background 0.2s;
  }
  .gift-btn:hover {
    background: var(--rust);
  }
  @media (max-width: 900px) {
    .section-gift {
      padding-left: 24px;
      padding-right: 24px;
    }
  }
</style>
