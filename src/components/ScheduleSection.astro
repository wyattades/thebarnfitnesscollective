---
/**
 * ScheduleSection — light "Weekly Schedule" strip. Days come from
 * src/data/classes.ts (schedule). `meta` may contain a newline for two lines.
 */
import { schedule } from "../data/classes";
import { site } from "../data/site";
---

<section id="schedule" class="section-schedule">
  <div class="schedule-header section-header fade-up">
    <div class="section-eyebrow">Weekly Schedule</div>
    <h2 class="section-title">Well-rounded <em>programming.</em></h2>
    <p class="section-body">
      Classes are 1 hour. All levels welcome. Every movement scalable. Leave
      feeling better than when you walked in.
    </p>
  </div>
  <div class="schedule-grid">
    {
      schedule.map((d) => (
        <div class={`schedule-day ${d.accent} fade-up`}>
          <div class="day-name">{d.day}</div>
          <div class="class-name">{d.className}</div>
          <div class="class-meta" set:html={d.meta.replace(/\n/g, "<br />")} />
        </div>
      ))
    }
  </div>
  <div class="schedule-cta">
    <a href={site.bookingUrl} class="btn-primary btn-rust" target="_blank" rel="noopener">
      View Full Schedule &amp; Book
    </a>
  </div>
</section>

<style>
  .section-schedule {
    background: var(--cream);
    color: var(--dark);
    padding: 100px 48px;
  }
  .schedule-header {
    max-width: var(--content-max);
    margin: 0 auto 0;
  }
  .schedule-header :global(.section-title) {
    color: var(--dark);
  }
  .schedule-header :global(.section-title em) {
    color: var(--rust);
  }
  .schedule-header :global(.section-body) {
    opacity: 0.8;
    color: var(--dark);
  }
  .schedule-header :global(.section-eyebrow) {
    color: var(--rust);
  }
  .schedule-header :global(.section-eyebrow::before) {
    background: var(--rust);
  }
  .schedule-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 16px;
    margin-top: 56px;
    max-width: var(--content-max);
    margin-left: auto;
    margin-right: auto;
  }
  .schedule-day {
    background: var(--off-white);
    border-radius: var(--radius);
    padding: 28px 24px;
    border-top: 3px solid transparent;
    transition: border-color 0.25s, transform 0.25s;
  }
  .schedule-day:hover {
    transform: translateY(-4px);
  }
  .schedule-day.rust {
    border-color: var(--rust);
  }
  .schedule-day.teal {
    border-color: var(--teal);
  }
  .schedule-day.coral {
    border-color: var(--coral);
  }
  .day-name {
    font-family: var(--font-stamp);
    font-size: 0.9rem;
    letter-spacing: 0.2em;
    color: var(--rust);
    margin-bottom: 6px;
  }
  .class-name {
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 700;
    color: var(--dark);
    margin-bottom: 8px;
    line-height: 1.2;
  }
  .class-meta {
    font-size: 0.78rem;
    opacity: 0.78;
    color: var(--dark);
    line-height: 1.5;
  }
  .schedule-cta {
    text-align: center;
    margin-top: 48px;
  }
  .btn-rust {
    background: var(--rust);
    color: var(--cream);
  }
  @media (max-width: 900px) {
    .section-schedule {
      padding-left: 24px;
      padding-right: 24px;
    }
  }
</style>
