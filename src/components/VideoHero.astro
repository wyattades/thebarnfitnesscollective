---
/**
 * VideoHero — the home page's opening video banner.
 * The "THE BARN / A FITNESS COLLECTIVE" wordmark + goat are baked into the
 * footage, so no text overlay is needed. Muted + looping so it autoplays
 * everywhere (including iOS via playsinline).
 *
 * Layout matches the original site: the video sits BELOW the fixed header and is
 * slightly inset from the edges (dark margins), so the wordmark reads fully
 * without being zoomed/cropped.
 *
 * To swap the video: replace public/video/hero.mp4 (and hero-poster.jpg).
 */
---

<section class="video-hero" aria-label="The Barn — A Fitness Collective">
  <video
    class="video-hero-media"
    autoplay
    muted
    loop
    playsinline
    preload="auto"
    poster="/video/hero-poster.jpg"
  >
    <source src="/video/hero.mp4" type="video/mp4" />
  </video>
</section>

<style>
  .video-hero {
    /* Reserve the fixed header at top + a small inset all around, so the video
       is a contained panel below the header (not a full-bleed background). */
    padding: var(--header-height) 32px 32px;
    background: var(--dark);
    box-sizing: border-box;
  }
  .video-hero-media {
    display: block;
    width: 100%;
    /* Show the video at its natural 16:9 so the baked-in wordmark reads fully
       (no zoom/crop), matching the original. Capped to the viewport height. */
    aspect-ratio: 16 / 9;
    max-height: calc(100vh - var(--header-height) - 64px);
    margin: 0 auto;
    object-fit: cover;
    object-position: center;
    background: #000;
  }
  @media (max-width: 900px) {
    .video-hero {
      padding: var(--header-height) 16px 16px;
    }
  }
</style>
